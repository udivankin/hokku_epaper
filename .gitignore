__pycache__/
.venv/
.claude/*
!.claude/commands
.private/
.cache/
.temp/

# Python build artifacts
build/
python/dist/
python/*.egg-info/
*.log

# Releases — shared dir holding every variant's built firmware
# (hokku-<vendor>_<model>-<version>.{bin,img}); build artifacts, never committed.
firmware/release/

# Firmware build artifacts: compiled objects/depfiles anywhere (ESP-IDF in-tree
# + host-test compilation of the shared C in firmware/common/), the ESP-IDF build
# dirs (all ESP32 screens), and host-test (CMake/CTest) build + output dirs.
firmware/**/*.o
firmware/**/*.d
firmware/*/build/
firmware/*/test/host/build*/
firmware/*/test/host/Testing/

# XR872 firmware build artifacts
firmware/bigme_f7/*.o
firmware/bigme_f7/*.d
firmware/bigme_f7/gcc/*.axf
firmware/bigme_f7/gcc/*.bin
firmware/bigme_f7/gcc/*.map
firmware/bigme_f7/gcc/.project.ld
firmware/bigme_f7/gcc/rom_symbol.ld
firmware/bigme_f7/image/xr872/app.bin
firmware/bigme_f7/image/xr872/app_xip.bin
firmware/bigme_f7/image/xr872/.image.cfg
firmware/bigme_f7/image/xr872/boot_40M.bin
firmware/bigme_f7/image/xr872/wlan_*.bin
firmware/bigme_f7/image/xr872/xr_system.img
firmware/bigme_f7/image/xr872/xr_system.img.version

# Local toolchain / config
FlashTools_repo/
settings_win.ini

# Editor / IDE
.vscode/
